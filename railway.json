{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks"
  },
  "deploy": {
    "startCommand": "gunicorn shortcut.wsgi:application --bind 0.0.0.0:$PORT",
    "healthcheckPath": "/admin/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "on_failure"
  }
} 