[Unit]
Description=Celery Beat Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/home/bero/Desktop/shortcut-store
Environment=DJANGO_SETTINGS_MODULE=shortcut.settings_production
ExecStart=/usr/local/bin/celery -A shortcut beat --loglevel=INFO
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/bero/Desktop/shortcut-store

[Install]
WantedBy=multi-user.target 