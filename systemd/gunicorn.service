[Unit]
Description=Gunicorn Django Application
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/home/bero/Desktop/shortcut-store
Environment=DJANGO_SETTINGS_MODULE=shortcut.settings_production
ExecStart=/usr/local/bin/gunicorn shortcut.wsgi:application --workers 3 --threads 2 --preload --timeout 60 --bind 127.0.0.1:8000 --max-requests 1000 --max-requests-jitter 100
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/bero/Desktop/shortcut-store

[Install]
WantedBy=multi-user.target 